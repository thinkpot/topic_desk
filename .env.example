# Postgres connection string. Use a serverless-friendly, pooled Postgres
# (Neon, Supabase, or Vercel Postgres) since API routes run as separate
# serverless function invocations on Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_chatbot?schema=public"

# The public URL this app is deployed at (used to register Telegram webhooks).
# Locally, this must be an HTTPS tunnel (e.g. ngrok) since Telegram requires HTTPS.
# On Vercel, set this to your production domain, e.g. https://your-app.vercel.app
APP_URL="http://localhost:3000"

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Only read by `npm run prisma:seed`, to create/update the first admin account.
# Leave unset to seed plans without creating an admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

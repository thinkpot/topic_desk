# --- Database: Prisma Postgres ---------------------------------------------
# LOCAL: start the bundled local Prisma Postgres server, then paste the
# DATABASE_URL it prints here:
#     npx prisma dev --name topicdesk --detach
#     npx prisma dev ls            # shows the URL again later
# It looks like: prisma+postgres://localhost:51213/?api_key=...
#
# PRODUCTION: create a Prisma Postgres database at https://console.prisma.io
# and use the connection string it gives you (also prisma+postgres://...).
DATABASE_URL=""

# The public URL this app is deployed at (used to register Telegram webhooks).
# Telegram requires HTTPS, so locally this must be a tunnel — see DEV_TUNNEL.
# In production, set it to your domain behind the reverse proxy.
APP_URL="http://localhost:3000"

# Local dev only: set to "cloudflared" and the server runs a Cloudflare quick
# tunnel itself, sets APP_URL to its URL, and re-registers every Telegram
# webhook whenever the tunnel restarts with a new URL. Leave unset when
# APP_URL is a fixed domain (production, or a named tunnel).
DEV_TUNNEL=""

# Signs login tokens. Production refuses to start with a placeholder or anything
# shorter than 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Only read by `npm run prisma:seed`, to create/update the first admin account.
# Leave unset to seed plans without creating an admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Optional: shows this app's own chat widget on its marketing homepage (app/page.tsx),
# so visitors can message you and you reply from Telegram like any other customer.
# Create a chatbot through the dashboard first, then paste its API key here.
# Each deployment (local, staging, production) has its own database, so each needs
# its own value — that's why this is an env var rather than hardcoded in the page.
SUPPORT_CHATBOT_API_KEY=""

# --- Email (Resend) -------------------------------------------------------
# Create a key at https://resend.com/api-keys. Email is optional: with no key
# set, the app logs what it would have sent and carries on, so local
# development and self-hosting never need an email provider.
RESEND_API_KEY=""
# Must use a domain verified in your Resend account.
EMAIL_FROM="Chatshore <noreply@yourdomain.com>"
# Where operational notifications go (new signups, chatbots going live,
# trials about to expire). Leave empty to disable them.
NOTIFY_EMAIL=""
# Shared secret for the scheduled trial-reminder endpoint, sent as
# `Authorization: Bearer <value>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave EMPTY in development:
# the tag only loads when this is set, so local traffic never reaches the
# production property. Set it in your hosting provider for production only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Realtime (Supabase Broadcast) -----------------------------------------
# Optional. Without these the app still works: the widget polls every ~3s and
# the dashboard falls back to Socket.io when server.ts is the host.
# Used purely as a transport — no application data is stored in Supabase.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Never expose this to a browser.
SUPABASE_SECRET_KEY=""

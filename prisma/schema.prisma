generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  VISITOR
  AGENT
  BOT
  SYSTEM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FlowStatus {
  NOT_STARTED
  RUNNING
  HANDED_OFF
  ENDED
}

// Plans live in the database so admins can change pricing and limits without a
// deploy. "Unlimited" is stored as UNLIMITED (see lib/plans.ts) rather than null
// so that limit comparisons stay plain numeric ones.
model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  priceINR        Int
  // Total charge for the year when billed annually (not a monthly rate) —
  // e.g. 4788 for a plan whose monthly-equivalent yearly rate is ₹399. 0 means
  // no yearly option is offered (the free plan has no billing cycle at all).
  priceYearlyINR  Int      @default(0)
  maxChatbots     Int
  maxMonthlyUsers Int
  isPaid          Boolean  @default(true)
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)
  // Live-visitor analytics tab: how many currently-active visitors this plan
  // can see at once (across all of the account's chatbots), and whether it
  // can also reply to them directly from the dashboard instead of Telegram.
  maxLiveVisitors       Int     @default(10)
  supportsDashboardChat Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  upgradeRequests UpgradeRequest[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(USER)
  planId        String
  plan          Plan      @relation(fields: [planId], references: [id])
  planExpiresAt DateTime?
  isSuspended   Boolean   @default(false)
  // Embedded in every JWT; bumping it (password change, suspension, "log out
  // everywhere") invalidates all tokens issued before, without a token table.
  tokenVersion  Int       @default(0)
  // When the account got its free trial — set once at signup, so the trial
  // can't be restarted by an admin downgrade or a plan change.
  trialStartedAt DateTime?
  // Signup onboarding answers ("what brings you here"), purely informational.
  companyName   String?
  websiteUrl    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatbots        Chatbot[]
  upgradeRequests UpgradeRequest[] @relation("UpgradeRequestUser")
  resolvedUpgradeRequests UpgradeRequest[] @relation("UpgradeRequestResolver")

  @@index([planId])
}

model Chatbot {
  id             String   @id @default(cuid())
  name           String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Publishable key embedded in the customer's page. Identifies the chatbot to
  // the widget endpoints; allowedDomains is what actually restricts use.
  apiKey         String   @unique
  botToken       String
  botUsername    String?
  groupChatId    String
  // Keys into the theme/font catalogs in lib/widget-appearance.ts.
  widgetTheme    String   @default("light-daylight")
  widgetFont     String   @default("system")
  welcomeMessage String   @default("Hi! How can we help you today?")
  isActive       Boolean  @default(true)
  allowedDomains String? // comma separated hostnames, empty = allow any
  webhookSecret  String
  // Once a conversation is HANDED_OFF or ENDED, this long of visitor silence
  // (or a matching restart keyword) re-triggers the flow from Start in the
  // same conversation/topic, instead of the bot staying silent forever.
  sessionTimeoutMinutes       Int     @default(30)
  restartKeywords             String  @default("hi, menu, restart, start over")
  keepVariablesAcrossSessions Boolean @default(true)
  // When on (premium plans only), a human handoff never opens a Telegram
  // topic — the owner replies from the dashboard's Live tab instead. See
  // handOffToHuman in lib/flow-runtime.ts.
  dashboardChatEnabled Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  stats         WidgetStat[]
  flow          Flow?
  liveVisitors  LiveVisitor[]

  @@index([userId])
}

// One drag-and-drop conversation flow per chatbot. Nodes/edges are stored as
// the raw React Flow graph (JSON) rather than normalized tables — node shapes
// differ per type (message/question/buttons/condition/...) and the canvas
// only ever reads/writes the whole graph at once, so normalizing it would add
// structure with no real query benefit.
model Flow {
  id        String   @id @default(cuid())
  chatbotId String   @unique
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  nodes     Json
  edges     Json
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id            String             @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot            @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId     String
  visitorName   String?
  pageUrl       String?
  // Null until a human takes over (either the flow hands off, or there's no
  // flow at all and the very first message creates the topic immediately).
  topicId       Int?
  status        ConversationStatus @default(OPEN)
  // Flow execution state. NOT_STARTED/ENDED conversations with no topicId yet
  // fall through to creating one on the next message, same as a bot-less chat.
  flowStatus    FlowStatus         @default(NOT_STARTED)
  currentNodeId String?
  variables     Json               @default("{}")
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())

  messages Message[]

  @@unique([chatbotId, visitorId])
  @@unique([chatbotId, topicId])
  @@index([chatbotId, createdAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  text           String
  // Present on a BOT message from a "buttons" node — the choices offered.
  buttons        Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

// Daily rollup of widget impressions, so "how many people saw the widget" is
// answerable without storing a row per page view.
model WidgetStat {
  id        String   @id @default(cuid())
  chatbotId String
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  views     Int      @default(0)
  opens     Int      @default(0)

  @@unique([chatbotId, date])
  @@index([chatbotId, date])
}

// A row per (chatbot, visitor) currently browsing with the widget loaded,
// updated by a heartbeat from the widget every few seconds — independent of
// whether they've ever opened the chat. "Live" is computed by the caller as
// lastSeenAt within a short window; there's no cleanup job, stale rows are
// just filtered out (same pattern as session-lifecycle staleness).
model LiveVisitor {
  id            String   @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId     String
  currentUrl    String
  scrollPercent Int      @default(0)
  referrer      String?
  userAgent     String?
  // Rolling list of { url, at } the visitor has been on, most recent last,
  // capped at 30 entries — enough for a "recent path" view without unbounded growth.
  pageViews     Json     @default("[]")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@unique([chatbotId, visitorId])
  @@index([chatbotId, lastSeenAt])
}

// No payment gateway: a customer asks for a plan from Billing, an admin
// approves it from /admin, and approval is what actually moves the account.
model UpgradeRequest {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation("UpgradeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle         @default(MONTHLY)
  status       UpgradeRequestStatus @default(PENDING)
  note         String?
  resolvedById String?
  resolvedBy   User?                @relation("UpgradeRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

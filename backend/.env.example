# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_chatbot?schema=public"

# Server
PORT=4000
# Public base URL of THIS backend, must be HTTPS in production (Telegram requires HTTPS for webhooks)
PUBLIC_BASE_URL="https://your-backend-domain.com"

# Comma separated list of frontend origins allowed to call the API / connect via socket
CORS_ORIGINS="http://localhost:3000"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
